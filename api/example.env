# Copy to .env and fill in. .env must stay out of git — it holds a Vault
# token and an RPC key, both of which are credentials.
#
# `bun run` loads .env automatically and child processes inherit it, so
# `bun run start:dev` and `bun run vitest` both pick this up with no extra
# wiring. Under plain node, use `node --env-file=.env` (20.6+) or add
# @nestjs/config.

# ---------------------------------------------------------------------------
# Custody — HashiCorp Vault Transit
# ---------------------------------------------------------------------------
# Start it with:
#   vault server -dev -dev-root-token-id=dev-only-token
#   vault secrets enable transit
#
# The dev server keeps everything in memory and is unsealed automatically,
# which is fine for a PoC and wrong for anything else. A real deployment
# uses a sealed server, AppRole auth rather than a root token, and a policy
# scoped to sign-only on the issuer key path.

VAULT_ADDR=http://127.0.0.1:8200

# The root token from the dev server. This is a credential: rotate it if it
# ever lands in a commit, a screenshot, or a demo recording.
VAULT_TOKEN=dev-only-token

# The mount path for the transit engine. Only change this if you enabled it
# somewhere other than the default.
VAULT_TRANSIT_MOUNT=transit

# ---------------------------------------------------------------------------
# Chain
# ---------------------------------------------------------------------------

# The public endpoint is heavily rate-limited; a Helius or QuickNode devnet
# URL is worth having. The key in that URL is a credential too.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Used only to build Explorer links. Keep it consistent with SOLANA_RPC_URL —
# pointing the API at mainnet while this says devnet produces links that
# resolve to nothing, which is a confusing way to find out.
SOLANA_CLUSTER=devnet

# The hot wallet. Pays account rent and transaction fees, and authorises
# nothing. Needs roughly 0.05 SOL per issuance; the client warns below that.
#
# This is deliberately NOT the issuance authority — that key lives in Vault
# and has no file anywhere on disk.
SOLANA_PAYER_KEYPAIR=/Users/you/.config/solana/id.json

# Where the Anchor IDL was synced to. Defaults to src/sukuk/idl/sukuk.json
# relative to the working directory, so this is normally left unset.
# Re-run `bun run sync:idl` after every `anchor build` — a stale IDL produces
# instruction data the deployed program will reject.
# SUKUK_IDL_PATH=

# ---------------------------------------------------------------------------
# Data directories
# ---------------------------------------------------------------------------
# Both default to <cwd>/templates and <cwd>/fixtures. Set them if the
# directories live somewhere else — under src/, for instance.

# TEMPLATES_DIR=src/templates
# FIXTURES_DIR=src/fixtures

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

PORT=3001
