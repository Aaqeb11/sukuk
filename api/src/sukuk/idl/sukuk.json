            "sukuk_asset"
          ]
        },
        {
          "name": "holder_token_account",
          "writable": true
        },
        {
          "name": "holder",
          "docs": [
            "The investor selling units back. Must sign to authorize the burn."
          ],
          "signer": true
        },
        {
          "name": "authority",
          "signer": true,
